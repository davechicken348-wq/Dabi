# Google Maps JavaScript API key (https://console.cloud.google.com/google/maps-apis/credentials)
# Used by the Locations hero map. Without it, the page falls back to a static map.
VITE_GOOGLE_MAPS_API_KEY=

# Base URL of the deployed Dabi backend (Render). On Vercel set this to the
# backend's public URL, e.g. https://dabi-backend.onrender.com
VITE_API_URL=http://localhost:4000
