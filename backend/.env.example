# Server
PORT=4000
# Frontend origin allowed by CORS (must be a valid URL)
CLIENT_URL=http://localhost:5173

# Environment: development | production | test
NODE_ENV=development

# Database (must be a postgresql:// connection string)
DATABASE_URL="postgresql://dabi_user:dabidatabasepassword@localhost:5432/dabi?schema=public"

# Secret used to sign admin session/JWT tokens.
# REQUIRED in production. In development a random fallback is used if omitted.
JWT_SECRET=change-me-to-a-long-random-string
